generator client {
  provider               = "prisma-client"
  output                 = "../server/utils/generated/prisma"
  previewFeatures        = []
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
  runtime                = "nodejs"
}

datasource db {
  provider = "sqlite"
}

enum DonationFrequency {
  ONE_TIME
  MONTHLY
  ANNUALLY
}

model User {
  id            String     @id @default(cuid())
  name          String     @default("Anonymous")
  status        Boolean    @default(false)
  phone         String?
  email         String     @unique @default("mplfboard@gmail.com")
  emailVerified Boolean    @default(false)
  permission    Int        @default(0)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  firstLogin    Boolean    @default(true)
  donations     Donation[]
  donors        Donor[]
  Events        Event[]
  grants        Grant[]
  grantors      Grantor[]
  Events        Event[]
  emailLogs     EmailLog[]
  logs          AuditLog[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Donor {
  id                     String     @id @default(cuid())
  boardMemberId          String?
  name                   String     @default("Anonymous")
  address                String?
  phone                  String?    @unique
  email                  String?    @unique
  preferredCommunication String?
  notes                  String?
  webLink                String?
  isAuthor               Boolean    @default(false)
  organization           String?
  donations              Donation[]
  boardMember            User?      @relation(fields: [boardMemberId], references: [id], onDelete: Restrict)
  Events                 Event[]    @relation("DonorToEvent")
}

model Grantor {
  id                     String  @id @default(cuid())
  boardMemberId          String?
  name                   String  @default("Anonymous")
  phone                  String?
  address                String?
  email                  String?
  preferredCommunication String?
  notes                  String?
  webLink                String?
  organization           String?
  grants                 Grant[]
  boardMember            User?   @relation(fields: [boardMemberId], references: [id], onDelete: Restrict)
}

model Donation {
  id                String    @id @default(cuid())
  boardMemberId     String?
  donorId           String?
  isAuthor          Boolean   @default(false)
  eventId           String?
  method            String?
  monetaryAmount    String?
  nonMonetaryAmount String?
  status            Int       @default(0) // 0: pending, 1: completed
  frequency         DonationFrequency @default(ONE_TIME)
  notes             String?
  reason            String?
  receivedDate      DateTime?
  lastEditDate      DateTime?
  event             Event?    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  donor             Donor?    @relation(fields: [donorId], references: [id], onDelete: Restrict)
  boardMember       User?     @relation(fields: [boardMemberId], references: [id], onDelete: Restrict)
}

model Grant {
  id                String    @id @default(cuid())
  boardMemberId     String?
  grantorId         String?
  purpose           String?
  method            String?
  monetaryAmount    String?
  nonMonetaryAmount String?
  status            Int?      @default(0)
  reimburse         Boolean   @default(false)
  notes             String?
  proposedDate      DateTime?
  receivedDate      DateTime?
  lastEditDate      DateTime?
  fileName          String?
  grantor           Grantor?  @relation(fields: [grantorId], references: [id], onDelete: Restrict)
  boardMember       User?     @relation(fields: [boardMemberId], references: [id], onDelete: Restrict)
}

model Event {
  id                String    @id @default(cuid())
  boardMemberId     String?
  boardMember       User?     @relation(fields: [boardMemberId], references: [id], onDelete: Restrict)
  eventName         String
  eventDate         DateTime?
  description       String?
  //like
  donors            Donor[]   @relation("DonorToEvent")
  donations         Donation[]
}

model EmailLog {
  id            String           @id @default(cuid())
  sentAt        DateTime         @default(now())
  senderId      String?
  sender        User?            @relation(fields: [senderId], references: [id], onDelete: SetNull)
  recipientType String           
  subject       String
  body          String
  recipients    EmailRecipient[]
}

model EmailRecipient {
  id         String   @id @default(cuid())
  emailLogId String
  emailLog   EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)
  donorId    String?
  grantorId  String?
  name       String   
  email      String   
  status     String   @default("pending") 
  error      String?
}

model AuditLog {
  id                String    @id @default(cuid())
  userId            String?
  action            String
  recordType        String
  recordId          String?
  createdAt         DateTime  @default(now())
  snapshot          Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@map("auditLog")
}


